--- a/spark_lab_diffusion_preview.py
+++ b/spark_lab_diffusion_preview.py
@@ -0,0 +1,84 @@
+# SPDX-License-Identifier: Apache-2.0
+"""SPARK_LAB_DIFFUSION_PREVIEW_V1: isolated, best-effort CPU telemetry helpers.
+
+No torch operations, model math, RNG, detokenizer state or completion counters.
+"""
+from __future__ import annotations
+from typing import Any
+
+
+def make_cpu_frames(req_ids, indices, lengths, tokens, steps, committing):
+    frames = {}
+    for index, length, canvas, step, commit in zip(
+        indices, lengths, tokens, steps, committing
+    ):
+        # No prefill rows reach this helper, and commit-only rows are omitted.
+        if commit or not 1 <= step <= 48:
+            continue
+        frames[req_ids[index]] = {
+            "version": 1, "kind": "best_guess", "denoising_step": int(step),
+            "token_ids": canvas[:length], "final": False,
+            "attribution_valid": True,
+        }
+    return frames
+
+
+def annotate_frame(frame, request_id, output_tokens, canvas_length, preemptions):
+    result = dict(frame)
+    result["request_id"] = request_id
+    result["block_index"] = output_tokens // canvas_length + 1
+    if preemptions:
+        # Reset/recomputation can make a block look as if it ran twice.
+        # Invalidate the visualization for this request instead of guessing.
+        result.update(attribution_valid=False, reason="request_preempted",
+                      token_ids=[], text="")
+    return result
+
+
+def merge_frames(first, second):
+    merged = list(first or ()) + list(second or ())
+    if len(merged) > 64:
+        dropped = len(merged) - 64
+        prior = sum(f.get("dropped_frames", 0) for f in merged[:dropped])
+        merged = merged[-64:]
+        merged[0] = dict(merged[0])
+        merged[0]["dropped_frames"] = merged[0].get("dropped_frames", 0) + dropped + prior
+    return merged
+
+
+def preview_eos_tokens(tokenizer: Any, model_config: Any):
+    """Resolve once per request; never read model generation config per frame."""
+    eos = set()
+    try:
+        values = [getattr(tokenizer, "eos_token_id", None),
+                  getattr(model_config.hf_text_config, "eos_token_id", None)]
+        try:
+            values.append(model_config.try_get_generation_config().get("eos_token_id"))
+        except Exception:
+            pass  # Tokenizer/HF EOS still provide a useful display boundary.
+        for value in values:
+            if isinstance(value, int):
+                eos.add(value)
+            elif isinstance(value, (list, tuple)):
+                eos.update(value)
+    except Exception:
+        pass  # Best-effort display metadata must not interrupt generation.
+    return eos
+
+
+def decode_frame(frame: dict[str, Any], tokenizer: Any, eos_token_ids):
+    result = dict(frame)
+    if not result.get("attribution_valid", True):
+        result["text"] = ""
+        return result
+    try:
+        # Keep the full canvas for audit. Only its display text stops at EOS;
+        # a later provisional frame can revise the EOS position.
+        ids = result["token_ids"]
+        end = next((i for i, token in enumerate(ids) if token in eos_token_ids), len(ids))
+        result["text"] = tokenizer.decode(ids[:end], skip_special_tokens=True)
+    except Exception:
+        # Telemetry failure must never abort generation or alter final text.
+        result.update(attribution_valid=False, reason="preview_decode_failed",
+                      token_ids=[], text="")
+    return result
